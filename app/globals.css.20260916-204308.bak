:root{
  --navy:#0b1f33;--navy2:#10283f;--ink:#13263a;--muted:#6d7b8c;--line:#e2e9ef;--soft:#f5f8fa;--soft2:#eef4f7;--white:#fff;--teal:#13a08b;--teal2:#66e3ce;--purple:#7b6df8;--amber:#e5a739;--red:#e75a66;
  --shadow:0 18px 50px rgba(13,31,51,.08);--radius:18px;
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:16px;-webkit-font-smoothing:antialiased}button,input{font:inherit}button,a{transition:.18s ease}a{text-decoration:none;color:inherit}svg{display:block;max-width:100%}

/* Brand */
.brand{display:inline-flex;align-items:center;gap:10px}.brand-mark{flex:0 0 38px}.brand-word{font-size:19px;font-weight:700;letter-spacing:-.055em}.brand-word span{color:var(--teal)}

/* Marketing */
.marketing{background:#fff;min-height:100vh}.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.95);border-bottom:1px solid #e8edf2;backdrop-filter:blur(16px)}.site-header-inner{height:76px;max-width:1440px;margin:auto;padding:0 32px;display:flex;align-items:center}.site-header nav{display:flex;gap:30px;margin-left:52px;color:#536173;font-size:14px;font-weight:600}.site-header nav a:hover{color:#0c1d2e}.header-actions{margin-left:auto;display:flex;align-items:center;gap:8px}.text-btn{padding:11px 15px;font-size:14px;font-weight:700;color:#415166}.text-btn:hover{background:#f4f6f8;border-radius:10px}.primary-btn,.secondary-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:11px;padding:13px 19px;font-size:14px;font-weight:750;border:1px solid transparent;cursor:pointer}.primary-btn{background:var(--navy);color:#fff;box-shadow:0 10px 26px rgba(11,31,51,.16)}.primary-btn:hover{background:#102b45;transform:translateY(-1px)}.primary-btn.small{padding:11px 16px}.secondary-btn{background:#fff;border-color:#d6e0e8;color:#26384b}.secondary-btn:hover{border-color:#b8c6d1;box-shadow:0 5px 18px rgba(15,32,48,.06)}.primary-btn.full,.secondary-btn.full{width:100%}.primary-btn.mint{background:#62dfc8;color:#082338;box-shadow:none}
.hero{position:relative;overflow:hidden;border-bottom:1px solid #e8edf2;background:linear-gradient(180deg,#fff 0%,#fbfdfe 100%)}.hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(#edf2f6 1px,transparent 1px),linear-gradient(90deg,#edf2f6 1px,transparent 1px);background-size:48px 48px;opacity:.34;mask-image:linear-gradient(to bottom,#000,transparent 78%);pointer-events:none}.hero-grid{position:relative;max-width:1440px;margin:auto;padding:92px 32px 100px;display:grid;grid-template-columns:.9fr 1.1fr;gap:62px;align-items:center}.hero-copy{max-width:640px}.eyebrow-pill{display:inline-flex;border:1px solid #d9e4eb;background:#fff;border-radius:999px;padding:8px 12px;color:#36526b;font-size:12px;font-weight:750;box-shadow:0 3px 12px rgba(20,43,63,.04)}.hero h1{font-size:64px;line-height:1.01;letter-spacing:-.065em;margin:24px 0 0;color:#0c1d2e;font-weight:700}.hero-copy>p{font-size:18px;line-height:1.72;color:#627083;margin:24px 0 0;max-width:610px}.hero-actions{display:flex;gap:10px;margin-top:30px;flex-wrap:wrap}.hero-proof{display:flex;gap:36px;border-top:1px solid #e4ebf0;margin-top:34px;padding-top:24px;color:#7b8998;font-size:12px}.hero-proof span{display:flex;flex-direction:column;gap:3px}.hero-proof b{color:#203348;font-size:18px}.hero-product{position:relative}.product-glow{position:absolute;inset:-35px;background:radial-gradient(circle,#dbeefa 0%,rgba(225,242,250,.7) 36%,transparent 72%);filter:blur(20px);z-index:0}.product-window{position:relative;z-index:1;background:#fff;border:1px solid #dce5ec;border-radius:18px;overflow:hidden;box-shadow:0 28px 70px rgba(17,40,58,.14)}.window-top{height:58px;border-bottom:1px solid #e5ebf0;display:flex;align-items:center;padding:0 15px;background:#fbfcfd}.window-brand{display:flex;align-items:center;gap:8px;font-size:12px;color:#24384b}.mini-mark{width:28px;height:28px;border-radius:8px;background:var(--navy);color:#62dfc8;display:grid;place-items:center;font-weight:800}.window-search{margin-left:28px;width:42%;background:#f1f5f7;border:1px solid #e4eaef;border-radius:8px;padding:8px 11px;color:#8794a2;font-size:10px}.avatar{margin-left:auto;width:29px;height:29px;border-radius:50%;background:#e5f5f1;color:#0e7e6d;display:grid;place-items:center;font-size:9px;font-weight:800}.window-body{display:grid;grid-template-columns:118px 1fr;min-height:420px}.preview-side{background:#0d2235;color:#8fa2b4;padding:18px 12px;display:flex;flex-direction:column;gap:8px;font-size:10px}.preview-side span,.preview-side b{padding:8px 9px;border-radius:7px}.preview-side b{background:#17354c;color:#fff}.preview-main{padding:20px;background:#f5f8fa}.preview-head{display:flex;justify-content:space-between;align-items:center}.preview-head small{color:#8995a2;font-size:9px}.preview-head h3{font-size:17px;margin:3px 0 0;letter-spacing:-.03em}.status-dot{color:#0a8d77;background:#eaf8f4;border-radius:99px;padding:5px 8px;font-size:9px}.preview-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:16px}.preview-metric{background:#fff;border:1px solid #e3e9ee;border-radius:10px;padding:11px}.preview-metric small{display:block;color:#8a97a4;font-size:8px}.preview-metric strong{display:block;font-size:16px;color:#1c3044;margin-top:4px}.preview-metric span{display:inline-block;margin-top:5px;font-size:7px;padding:3px 5px;border-radius:99px}.preview-metric .ok{background:#e8f8f3;color:#087d69}.preview-metric .watch{background:#fff4df;color:#9b6714}.preview-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:10px;margin-top:10px}.preview-card{background:#fff;border:1px solid #e3e9ee;border-radius:11px;padding:13px;min-height:190px}.card-head{display:flex;justify-content:space-between;font-size:9px;color:#8895a4}.card-head b{color:#34475a}.preview-chart{margin-top:15px}.risk-card{text-align:center}.risk-ring{width:104px;height:104px;border-radius:50%;margin:17px auto 8px;background:conic-gradient(#1aaa88 0 66%,#f0b84b 66% 82%,#ed6470 82% 100%);display:grid;place-items:center;position:relative}.risk-ring:after{content:"";position:absolute;width:70px;height:70px;border-radius:50%;background:#fff}.risk-ring div{position:relative;z-index:1;display:flex;flex-direction:column}.risk-ring strong{font-size:20px}.risk-ring span{font-size:8px;color:#7c8998}.risk-legend{display:flex;gap:8px;justify-content:center;font-size:7px;color:#748395}.risk-legend i{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:3px}.risk-legend .low{background:#1aaa88}.risk-legend .med{background:#f0b84b}.risk-legend .high{background:#ed6470}
.trust-strip{border-bottom:1px solid #e8edf2;background:#fafcfd}.trust-strip>div{max-width:1340px;margin:auto;padding:22px 32px;display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;color:#69788a;font-size:13px}.trust-strip b{color:#2c3e50}.section{max-width:1340px;margin:auto;padding:110px 32px}.section-intro{display:grid;grid-template-columns:.9fr 1.1fr;gap:70px;align-items:end}.section-intro h2,.pricing-intro h2,.dark-copy h2,.final-cta h2{font-size:48px;line-height:1.07;letter-spacing:-.055em;margin:12px 0 0;color:#102234}.section-intro p{max-width:610px;justify-self:end;color:#6b798a;line-height:1.7}.section-kicker{font-size:11px;font-weight:800;letter-spacing:.16em;color:#0b8f7d}.section-kicker.light{color:#66e3ce}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:55px}.feature-card{border:1px solid #e1e8ed;border-radius:16px;padding:25px;background:#fff;min-height:300px;display:flex;flex-direction:column}.feature-number{font-size:11px;color:#8291a0;font-weight:800}.feature-card h3{font-size:21px;letter-spacing:-.035em;margin:34px 0 10px}.feature-card p{color:#718092;font-size:14px;line-height:1.7;margin:0}.feature-card a{margin-top:auto;color:#0b8f7d;font-size:13px;font-weight:750}.dark-section{background:#0a1d30;color:#fff;padding:100px 32px}.dark-inner{max-width:1340px;margin:auto;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px;align-items:center}.dark-copy h2{color:#fff}.dark-copy>p{color:#9fb0c0;line-height:1.75;font-size:16px;max-width:560px}.steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:36px;border-top:1px solid rgba(255,255,255,.12);padding-top:22px}.steps div{display:flex;flex-direction:column;gap:6px}.steps span{font-size:10px;color:#6edfcf}.steps b{font-size:13px}.workflow-panel{background:#102a42;border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:16px;box-shadow:0 24px 60px rgba(0,0,0,.18)}.workflow-row{display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:14px;background:#fff;color:#25384c;border-radius:12px;padding:14px;margin-bottom:10px}.file-icon{width:43px;height:43px;border-radius:10px;background:#eaf8f4;color:#0c8e7a;display:grid;place-items:center;font-size:9px;font-weight:800}.workflow-row div{display:flex;flex-direction:column;gap:4px}.workflow-row b{font-size:13px}.workflow-row small{font-size:10px;color:#8290a0}.workflow-row em{font-style:normal;font-size:9px;background:#eaf8f4;color:#087965;border-radius:99px;padding:5px 8px}.workflow-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.workflow-summary>div{background:#0c2237;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:14px}.workflow-summary small{display:block;color:#7f94a8;font-size:9px}.workflow-summary strong{display:block;color:#fff;font-size:18px;margin-top:4px}.intelligence{padding-bottom:120px}.intel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}.intel-grid article{background:#f7fafb;border:1px solid #e2e9ee;border-radius:16px;padding:28px}.intel-icon{width:44px;height:44px;border-radius:12px;background:#e6f8f4;color:#0c927e;display:grid;place-items:center;font-size:18px;font-weight:800}.intel-grid h3{font-size:20px;margin:22px 0 8px}.intel-grid p{margin:0;color:#6f7e8f;line-height:1.7;font-size:14px}.pricing-section{background:#f6f9fb;padding:110px 32px;border-top:1px solid #e3e9ef}.pricing-intro{max-width:1340px;margin:auto}.pricing-intro h2{max-width:760px}.plans{max-width:1340px;margin:48px auto 0;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.plan{position:relative;background:#fff;border:1px solid #e0e7ed;border-radius:17px;padding:25px;min-height:390px;display:flex;flex-direction:column}.plan.featured{border-color:#79d9c7;box-shadow:0 14px 38px rgba(16,145,124,.11)}.plan-tag{position:absolute;right:18px;top:18px;background:#e6f8f4;color:#0b8a77;border-radius:99px;padding:5px 8px;font-size:9px;font-weight:800}.plan h3{margin:0;font-size:18px}.plan>p{color:#7c8998;font-size:13px}.price{font-size:34px;font-weight:750;letter-spacing:-.05em;margin:18px 0}.price small{font-size:11px;color:#8793a1;font-weight:600;letter-spacing:0}.plan ul{list-style:none;padding:0;margin:0 0 25px;display:grid;gap:11px;color:#5e6e7f;font-size:13px}.plan .full{margin-top:auto}.final-cta{background:#0b1f33;color:#fff;padding:72px max(32px,calc((100vw - 1340px)/2));display:flex;justify-content:space-between;gap:40px;align-items:center}.final-cta h2{color:#fff;max-width:820px;font-size:42px}.final-cta p{color:#9cb0c2}footer{border-top:1px solid #e4eaef;background:#fff}footer>div{max-width:1340px;margin:auto;padding:28px 32px;display:flex;align-items:center;gap:28px;color:#7f8c99;font-size:12px}footer nav{margin-left:auto;display:flex;gap:22px}

/* Authentication */
.auth-page{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;background:#f6f9fb}.auth-visual{position:relative;background:#0a1d30;color:#fff;overflow:hidden;padding:44px 54px;display:flex;flex-direction:column}.auth-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:48px 48px}.auth-visual:after{content:"";position:absolute;width:650px;height:650px;border-radius:50%;background:radial-gradient(circle,rgba(91,224,205,.16),transparent 65%);left:-180px;top:-180px}.auth-brand{position:relative;z-index:2}.auth-copy{position:relative;z-index:2;margin:auto 0;max-width:620px}.auth-copy h1{font-size:52px;line-height:1.02;letter-spacing:-.06em;margin:18px 0}.auth-copy>p{color:#9fb1c0;font-size:16px;line-height:1.75;max-width:560px}.auth-copy ul{list-style:none;padding:0;margin:32px 0 0;display:grid;gap:14px;color:#d9e4eb;font-size:14px}.auth-copy li{display:flex;align-items:center;gap:11px}.auth-copy li span{width:24px;height:24px;border-radius:50%;background:#173c42;color:#69e4d1;display:grid;place-items:center;font-size:11px}.auth-foot{position:relative;z-index:2;color:#71869a;font-size:11px}.auth-form-wrap{display:flex;align-items:center;justify-content:center;padding:44px}.auth-form{width:100%;max-width:470px}.mobile-brand{display:none;margin-bottom:32px}.auth-form h2{font-size:36px;letter-spacing:-.045em;margin:10px 0 0}.auth-sub{color:#768596;font-size:14px;line-height:1.6}.provider-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:26px}.provider-row button{background:#fff;border:1px solid #dbe4ea;border-radius:11px;padding:12px;color:#405264;font-size:13px;font-weight:700;cursor:pointer}.provider-row button:hover{border-color:#b7c6d1}.divider{display:flex;align-items:center;gap:12px;margin:23px 0;color:#98a4b0;font-size:10px;text-transform:uppercase;letter-spacing:.12em}.divider span{height:1px;background:#dfe7ec;flex:1}.auth-form form{display:grid;gap:15px}.auth-form label{font-size:13px;font-weight:700;color:#405264}.auth-form input{width:100%;margin-top:7px;border:1px solid #d7e1e7;background:#fff;border-radius:11px;padding:12px 13px;color:#203246;outline:none}.auth-form input:focus{border-color:#70ccbd;box-shadow:0 0 0 4px #dff5f1}.submit-btn{border:0;border-radius:11px;background:#0b7568;color:#fff;padding:13px 16px;font-weight:750;cursor:pointer;display:flex;justify-content:center;gap:10px}.submit-btn:hover{background:#096357}.form-error{background:#fff0f2;border:1px solid #f0c9ce;color:#b3444f;border-radius:10px;padding:10px 12px;font-size:12px}.demo-box{margin-top:18px;background:#eef9f6;border:1px solid #d6ece7;border-radius:11px;padding:13px;display:grid;gap:3px;color:#5f7b7b;font-size:11px}.demo-box b{color:#2e5351}.auth-switch{text-align:center;color:#7c8997;font-size:13px;margin-top:20px}.auth-switch button{border:0;background:none;color:#0b8d7b;font-weight:750;cursor:pointer}

/* App shell */
.app-shell{min-height:100vh;background:#f4f7f9}.sidebar{position:fixed;inset:0 auto 0 0;width:250px;background:#0c1d2f;color:#c1ceda;z-index:40;display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,.04)}.sidebar-brand{height:72px;display:flex;align-items:center;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.07)}.mobile-close{display:none;margin-left:auto;border:0;background:none;color:#fff;font-size:25px}.workspace-chip{margin:15px 14px 8px;padding:11px;border:1px solid rgba(255,255,255,.08);background:#10283d;border-radius:11px;display:flex;align-items:center;gap:10px}.workspace-chip>span{width:32px;height:32px;border-radius:9px;background:#17394d;color:#6de0cf;display:grid;place-items:center;font-size:10px;font-weight:800}.workspace-chip div{min-width:0}.workspace-chip b,.workspace-chip small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.workspace-chip b{color:#fff;font-size:11px}.workspace-chip small{color:#71879b;font-size:9px;margin-top:2px}.app-nav{padding:8px 10px;overflow-y:auto;flex:1}.nav-section{display:block;margin:14px 10px 5px;color:#597086;font-size:8px;font-weight:800;letter-spacing:.12em}.app-nav button{width:100%;border:0;background:transparent;color:#9eb0c0;border-radius:9px;padding:9px 10px;display:flex;align-items:center;gap:10px;text-align:left;font-size:12px;font-weight:600;cursor:pointer;margin:2px 0}.app-nav button>span{width:20px;color:#6d879d;text-align:center}.app-nav button:hover{background:#122b40;color:#fff}.app-nav button.active{background:#17374b;color:#fff}.app-nav button.active>span{color:#68dfcc}.app-nav button em{margin-left:auto;font-style:normal;font-size:7px;color:#64ddca;background:#153f45;border-radius:99px;padding:3px 5px}.sidebar-user{border-top:1px solid rgba(255,255,255,.07);padding:13px 14px;display:grid;grid-template-columns:34px 1fr 28px;gap:9px;align-items:center}.sidebar-user>span{width:34px;height:34px;border-radius:10px;background:#17374b;color:#6be0cc;display:grid;place-items:center;font-size:9px;font-weight:800}.sidebar-user div{min-width:0}.sidebar-user b,.sidebar-user small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.sidebar-user b{font-size:10px;color:#fff}.sidebar-user small{font-size:8px;color:#71879b}.sidebar-user button{border:0;background:transparent;color:#71879b;cursor:pointer}.app-body{min-height:100vh;margin-left:250px}.topbar{height:72px;background:#fff;border-bottom:1px solid #e1e8ed;display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:30}.topbar-left,.topbar-right{display:flex;align-items:center;gap:9px}.menu-btn{display:none;border:1px solid #dce4ea;background:#fff;border-radius:9px;padding:7px 9px}.search-box{height:38px;width:340px;border:1px solid #dce4ea;background:#f9fbfc;border-radius:9px;display:flex;align-items:center;gap:8px;padding:0 11px;color:#8492a1;font-size:11px}.search-box kbd{margin-left:auto;background:#edf2f5;border:1px solid #dbe3e8;border-radius:5px;padding:2px 5px;font-size:8px}.site-select,.icon-btn{border:1px solid #dce4ea;background:#fff;color:#586a7c;border-radius:9px;height:36px;padding:0 11px;font-size:11px}.icon-btn{width:36px;padding:0}.top-avatar{width:35px;height:35px;border-radius:10px;background:#0e2b40;color:#68dfcb;display:grid;place-items:center;font-size:9px;font-weight:800}.app-main{max-width:1600px;margin:auto;padding:28px 30px 70px}.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;margin-bottom:22px}.page-kicker{display:block;color:#0b927f;font-size:9px;letter-spacing:.14em;font-weight:800}.page-heading h1{font-size:29px;letter-spacing:-.045em;margin:6px 0 4px}.page-heading p{margin:0;color:#788797;font-size:12px}.page-actions{display:flex;gap:8px}.btn{border:1px solid transparent;border-radius:9px;padding:9px 13px;font-size:11px;font-weight:750;cursor:pointer}.btn.primary{background:#0c8e7c;color:#fff}.btn.primary:hover{background:#087a6b}.btn.ghost{background:#fff;border-color:#d9e3e9;color:#506275}.btn.light{background:#fff;color:#173248;border-color:#fff}.btn.danger{background:#fff1f2;border-color:#f1c8cd;color:#b3444f}.btn:disabled{opacity:.6;cursor:wait}.summary-strip{display:grid;grid-template-columns:repeat(4,1fr);background:#0d2438;color:#fff;border-radius:15px;overflow:hidden;margin-bottom:14px}.summary-strip>div{padding:18px 20px;border-right:1px solid rgba(255,255,255,.08)}.summary-strip>div:last-child{border-right:0}.summary-strip span{display:block;color:#7f96aa;font-size:9px;text-transform:uppercase;letter-spacing:.08em}.summary-strip strong{display:block;font-size:27px;letter-spacing:-.04em;margin:4px 0}.summary-strip strong small{font-size:11px;color:#91a5b7}.summary-strip em{font-style:normal;color:#63d8c5;font-size:9px}.metric-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}.metric-card{background:#fff;border:1px solid #e0e7ec;border-radius:12px;padding:15px}.metric-top{display:flex;align-items:center;justify-content:space-between;color:#788695;font-size:9px;font-weight:750}.metric-dot{width:7px;height:7px;border-radius:50%;background:#13a180}.metric-dot.warn{background:#e5aa3d}.metric-card>strong{display:block;color:#203348;font-size:22px;letter-spacing:-.035em;margin:8px 0}.metric-bottom{display:flex;flex-direction:column;gap:3px}.metric-bottom span{color:#8b98a5;font-size:8px}.metric-bottom em{font-style:normal;color:#0d927f;font-size:8px;font-weight:700}.dashboard-grid{display:grid;grid-template-columns:1.55fr .75fr;gap:12px;margin-top:12px}.dashboard-grid.lower{grid-template-columns:1.35fr .65fr}.panel{background:#fff;border:1px solid #e0e7ec;border-radius:13px;padding:18px;box-shadow:0 2px 5px rgba(23,42,60,.02)}.panel.tall{margin-top:12px;padding-bottom:28px}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.panel-head h2,.settings-grid h2{font-size:13px;margin:0;color:#26394c}.panel-head p{font-size:9px;color:#8895a3;margin:4px 0 0}.panel-badge{font-size:8px;padding:5px 7px;border-radius:99px;background:#f0f4f6;color:#758494}.panel-badge.good{background:#e8f8f3;color:#087c69}.trend-chart{margin-top:12px;min-height:190px}.chart-legend{border-top:1px solid #edf1f4;padding-top:11px;display:flex;gap:19px;color:#738191;font-size:9px}.legend-line{display:inline-block;width:16px;border-top:2px solid;margin-right:6px;vertical-align:middle}.legend-line.teal{border-color:#149b86}.legend-line.target{border-color:#9da9b4;border-style:dashed}.risk-content{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:8px;min-height:220px}.risk-donut{width:132px;height:132px;border-radius:50%;display:grid;place-items:center;position:relative;margin:auto}.risk-donut:before{content:"";position:absolute;width:88px;height:88px;border-radius:50%;background:#fff}.risk-donut>div{z-index:1;text-align:center}.risk-donut strong{display:block;font-size:26px}.risk-donut span{font-size:8px;color:#83909e}.risk-list{display:grid;gap:10px}.risk-list>div{display:flex;justify-content:space-between;color:#68788a;font-size:9px}.risk-list b{color:#26384a}.risk-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px}.risk-dot.low{background:#18aa86}.risk-dot.med{background:#f0b84b}.risk-dot.high{background:#ef626b}.table-wrap{overflow:auto;margin-top:13px}.data-table{width:100%;border-collapse:collapse;min-width:720px}.data-table th{color:#8593a0;font-size:8px;text-align:left;font-weight:750;padding:8px;border-bottom:1px solid #e8edf1;text-transform:uppercase;letter-spacing:.05em}.data-table td{font-size:9px;color:#596a7b;padding:9px 8px;border-bottom:1px solid #eef2f4}.driver-cell{display:flex;align-items:center;gap:8px;min-width:140px}.driver-avatar{width:27px;height:27px;border-radius:8px;background:#e9f5f2;color:#0b8e7b;display:grid;place-items:center;font-size:8px;font-weight:800}.driver-cell b,.driver-cell small{display:block}.driver-cell b{font-size:9px;color:#2b3d50}.driver-cell small{f