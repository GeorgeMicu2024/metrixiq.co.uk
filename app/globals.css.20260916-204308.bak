dius:9px;background:#f0f5f7;color:#7c8b9a;display:grid;place-items:center;font-size:9px;font-weight:800}.coach-main{display:grid;grid-template-columns:220px 1fr;align-items:center;gap:25px}.coach-main p{margin:0;color:#6d7c8d;font-size:9px}.intel-app-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:12px}.insight-hero{background:linear-gradient(135deg,#0c2438,#0e3b43);color:#fff;border-radius:14px;padding:30px;min-height:310px;display:flex;flex-direction:column;align-items:flex-start}.insight-hero>span{font-size:8px;color:#64dfcc;letter-spacing:.14em;font-weight:800}.insight-hero h2{font-size:30px;line-height:1.1;letter-spacing:-.045em;max-width:640px;margin:17px 0 10px}.insight-hero p{color:#a1b4c2;font-size:11px;line-height:1.7;max-width:650px}.insight-hero .btn{margin-top:auto}.evidence-list{display:grid;margin-top:13px}.evidence-list>div{display:flex;justify-content:space-between;border-bottom:1px solid #edf1f3;padding:13px 0;font-size:10px}.evidence-list span{color:#718091}.import-drop{border:1.5px dashed #bcd0d8;background:linear-gradient(180deg,#fbfdfd,#f5faf8);border-radius:14px;min-height:240px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;cursor:pointer}.upload-icon{width:52px;height:52px;border-radius:14px;background:#e2f6f1;color:#0b927e;display:grid;place-items:center;font-size:22px}.import-drop h2{font-size:16px;margin:15px 0 6px}.import-drop p{font-size:10px;color:#80909e;margin:0 0 14px}.import-review,.import-result{margin-top:12px}.file-list{display:grid;gap:8px;margin-top:13px}.file-list>div{display:grid;grid-template-columns:44px 1fr auto;gap:10px;align-items:center;background:#f9fbfc;border:1px solid #e6ecef;border-radius:10px;padding:10px}.file-type{width:37px;height:37px;border-radius:9px;background:#e7f7f3;color:#0b8d79;display:grid;place-items:center;font-size:7px;font-weight:800}.file-list b,.file-list small{display:block}.file-list b{font-size:10px}.file-list small{font-size:8px;color:#8996a3}.file-list em{font-style:normal;font-size:8px;color:#0b8d79}.import-message{margin-top:12px;border:1px solid #cfe9e2;background:#edf9f6;color:#2e756b;border-radius:10px;padding:11px;font-size:10px}.import-message.error{border-color:#f0c9ce;background:#fff2f3;color:#b44652}.result-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:13px}.result-grid>div{background:#f7fafb;border:1px solid #e7ecef;border-radius:9px;padding:12px}.result-grid span{display:block;color:#82909f;font-size:8px}.result-grid strong{display:block;font-size:20px;margin-top:3px}.pdf-note{margin-top:12px;background:#f7fafb;border-radius:9px;padding:12px;font-size:9px;color:#6c7d8d}.pdf-note b{display:block;color:#2c3d50}.pdf-note p{margin:5px 0 0}.report-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.report-grid article{background:#fff;border:1px solid #e0e7ec;border-radius:12px;padding:19px;min-height:190px;display:flex;flex-direction:column}.report-grid article>span{width:38px;height:38px;border-radius:10px;background:#eaf7f4;color:#0d927f;display:grid;place-items:center}.report-grid h3{font-size:13px;margin:18px 0 6px}.report-grid p{font-size:9px;color:#788898;line-height:1.6;margin:0}.report-grid button{margin-top:auto;border:0;background:none;text-align:left;color:#0b907d;font-size:9px;font-weight:750;padding:0;cursor:pointer}.billing-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.billing-grid article{position:relative;background:#fff;border:1px solid #e0e7ec;border-radius:13px;padding:20px;min-height:315px;display:flex;flex-direction:column}.billing-grid article.current{border-color:#77d4c3}.current-tag{position:absolute;right:14px;top:14px;background:#e6f8f4;color:#087d69;border-radius:99px;padding:4px 6px;font-size:7px;font-weight:800}.billing-grid h3{font-size:13px}.billing-grid>article>strong{font-size:28px;margin:15px 0}.billing-grid strong small{font-size:9px;color:#8b98a5}.billing-grid ul{list-style:none;padding:0;display:grid;gap:9px;color:#627283;font-size:9px}.billing-grid .btn{margin-top:auto}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.setting-row{display:flex;justify-content:space-between;border-bottom:1px solid #edf1f4;padding:13px 0;font-size:10px}.setting-row span{color:#7f8d9b}.settings-copy{color:#708091;font-size:10px;line-height:1.7;margin:16px 0 22px}
.mobile-overlay{display:none}

@media(max-width:1200px){.hero-grid{grid-template-columns:1fr;gap:48px}.hero-copy{max-width:800px}.hero h1{font-size:56px}.feature-grid,.plans{grid-template-columns:repeat(2,1fr)}.metric-grid{grid-template-columns:repeat(3,1fr)}.dashboard-grid,.dashboard-grid.lower{grid-template-columns:1fr}.billing-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.site-header nav{display:none}.hero-grid,.section,.trust-strip>div{padding-left:22px;padding-right:22px}.section-intro,.dark-inner{grid-template-columns:1fr;gap:30px}.section-intro p{justify-self:start}.auth-page{grid-template-columns:1fr}.auth-visual{display:none}.mobile-brand{display:inline-flex}.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:translateX(0)}.mobile-close{display:block}.mobile-overlay{display:block;position:fixed;inset:0;background:rgba(7,20,32,.45);z-index:35;border:0}.app-body{margin-left:0}.menu-btn{display:block}.topbar{padding:0 16px}.search-box{width:260px}.app-main{padding:22px 16px 60px}.coach-main{grid-template-columns:1fr}.coaching-list article{grid-template-columns:36px 1fr auto}.coaching-list .btn{display:none}.intel-app-grid,.settings-grid{grid-template-columns:1fr}}
@media(max-width:680px){.site-header-inner{padding:0 16px}.header-actions .text-btn{display:none}.hero-grid{padding-top:58px}.hero h1{font-size:42px}.hero-copy>p{font-size:16px}.hero-proof{gap:18px}.window-body{grid-template-columns:1fr}.preview-side{display:none}.preview-metrics{grid-template-columns:repeat(2,1fr)}.preview-grid{grid-template-columns:1fr}.section{padding-top:78px;padding-bottom:78px}.section-intro h2,.pricing-intro h2,.dark-copy h2,.final-cta h2{font-size:36px}.feature-grid,.intel-grid,.plans{grid-template-columns:1fr}.dark-section{padding:78px 20px}.workflow-summary{grid-template-columns:1fr}.final-cta{padding:58px 20px;flex-direction:column;align-items:flex-start}.summary-strip{grid-template-columns:repeat(2,1fr)}.summary-strip>div:nth-child(2){border-right:0}.metric-grid,.performance-cards,.report-grid,.billing-grid{grid-template-columns:1fr 1fr}.topbar-right .site-select,.topbar-right .icon-btn{display:none}.search-box{width:auto;flex:1}.search-box span{display:none}.search-box kbd{display:none}.page-heading{align-items:flex-start;flex-direction:column}.result-grid{grid-template-columns:1fr 1fr}.risk-content{grid-template-columns:1fr}.provider-row{grid-template-columns:1fr}.auth-form-wrap{padding:28px 18px}.auth-form h2{font-size:30px}}
@media(max-width:450px){.metric-grid,.performance-cards,.report-grid,.billing-grid{grid-template-columns:1fr}.summary-strip{grid-template-columns:1fr}.summary-strip>div{border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}.hero h1{font-size:38px}.hero-proof{display:grid;grid-template-columns:repeat(3,1fr)}.preview-main{padding:12px}.site-header .primary-btn.small{padding:10px 11px;font-size:12px}}
@media print{.sidebar,.topbar,.page-actions,.btn,button{display:none!important}.app-body{margin-left:0}.app-main{padding:0}.panel{break-inside:avoid}}


/* Historical analytics */
.history-heading{align-items:flex-end}.history-range{display:flex;flex-wrap:wrap;gap:6px;background:#f2f6f8;border:1px solid var(--line);padding:5px;border-radius:12px}.history-range button{border:0;background:transparent;color:#647487;border-radius:8px;padding:8px 11px;font-size:12px;font-weight:750;cursor:pointer}.history-range button.active{background:#fff;color:#10283f;box-shadow:0 2px 8px rgba(13,31,51,.08)}.history-panel{margin-top:14px}.history-chart{width:100%;height:260px;margin-top:8px}.history-metric-select{border:1px solid #dce5eb;background:#fff;border-radius:9px;padding:9px 12px;color:#31485b;font-weight:650}.history-empty{min-height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8190a0;gap:6px}.history-empty b{color:#314559}.history-empty.compact{min-height:90px}.history-table-panel{margin-top:14px}.history-table td,.history-table th{white-space:nowrap}.history-date{display:block;margin-top:3px;color:#8c99a7;font-size:10px}.concession-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}.concession-summary article{background:#0d2237;color:#fff;border-radius:15px;padding:20px 22px;border:1px solid #18354e}.concession-summary span{display:block;color:#91a7ba;font-size:11px;text-transform:uppercase;letter-spacing:.08em}.concession-summary strong{display:block;font-size:30px;margin-top:7px}.concession-summary small{display:block;color:#6fdac8;margin-top:5px}.concessions-table-wrap{overflow:auto;max-width:100%}.concessions-table th,.concessions-table td{white-space:nowrap;text-align:center}.concessions-table th:nth-child(2),.concessions-table td:nth-child(2){text-align:left}.rank-badge{width:26px;height:26px;display:inline-grid;place-items:center;border-radius:8px;background:#edf2f6;color:#536678;font-weight:800}.rank-1{background:#10283f;color:#fff}.rank-2{background:#dce8ee;color:#203b50}.rank-3{background:#eaf1f4;color:#29465b}.concession-cell{min-width:28px;height:28px;padding:0 7px;border-radius:8px;display:inline-grid;place-items:center;background:#f2f5f7;color:#8794a1;font-weight:750}.concession-cell.low{background:#fff3dc;color:#9a6512}.concession-cell.med{background:#ffe3b3;color:#87530a}.concession-cell.high{background:#ffe0e3;color:#b53d49}.trend-arrow{font-size:18px;font-weight:850;color:#325069}@media(max-width:900px){.history-heading{align-items:flex-start}.concession-summary{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.concession-summary{grid-template-columns:1fr}.history-range{width:100%}.history-range button{flex:1}}


/* Top tier analytics v2 */
.search-box input{border:0;outline:0;background:transparent;min-width:230px;width:100%;color:#31465a;font-size:13px}.search-box input::placeholder{color:#8997a6}.leaderboard-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.leaderboard-table td,.leaderboard-table th{white-space:nowrap}.panel-badge.warn{background:#fff0e6;color:#a85b25}.target-card.warn{border-color:#efd4a0}.target-card.warn strong{color:#9a6512}.mentor-summary{margin-top:0}.mentor-table th,.mentor-table td{white-space:nowrap}.mentor-risk{display:inline-flex;padding:5px 8px;border-radius:999px;background:#f0f3f5;color:#718091;font-size:11px;font-weight:750}.mentor-risk.low{background:#e7f7f1;color:#087d69}.mentor-risk.med{background:#fff2d9;color:#99640f}.mentor-risk.high{background:#ffe2e5;color:#b33f4b}.score-pill{display:inline-flex;min-width:48px;justify-content:center;padding:6px 8px;border-radius:8px;font-weight:800}.score-pill.good{background:#e7f7f1;color:#087d69}.score-pill.warn{background:#fff0dc;color:#9b6611}.missing-cell{color:#a8b2bc}.mini-history-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(90px,1fr));gap:8px;margin-top:18px}.mini-history-list div{border:1px solid #e2e9ef;border-radius:10px;padding:12px;background:#f8fafb}.mini-history-list span{display:block;color:#8795a4;font-size:10px}.mini-history-list b{display:block;margin-top:5px;font-size:18px}.file-status-error{color:#b33f4b}@media(max-width:1000px){.leaderboard-grid{grid-template-columns:1fr}}@media(max-width:700px){.search-box input{min-width:0}}


/* MetrixIQ Professional Operations Console v4 */
.scorecard-page-heading{align-items:flex-end;gap:20px}.scorecard-filter-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.scorecard-filter-row select,.table-tools select,.data-table select,.site-select{border:1px solid #dce5eb;background:#fff;border-radius:10px;padding:10px 13px;color:#30465a;font-weight:650;min-height:40px}.team-overview-card{background:#fff;border:1px solid #dfe8ee;border-radius:18px;padding:22px;margin-bottom:14px;box-shadow:0 2px 9px rgba(16,40,63,.025)}.team-overview-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding-bottom:18px;border-bottom:1px solid #edf2f5}.team-overview-head span:first-child{font-size:10px;letter-spacing:.13em;color:#7990a2;font-weight:800}.team-overview-head h2{font-size:18px;margin:5px 0 0;color:#14273b}.standing-chip{padding:8px 13px;border-radius:999px;background:#edf6ef;color:#4b7d55;font-size:12px;font-weight:800}.standing-chip.fantastic,.standing-chip.fantastic-plus{background:#e8f0ff;color:#506fc4}.standing-chip.great{background:#eef5e6;color:#68843f}.standing-chip.fair{background:#fbefe4;color:#a86a3c}.standing-chip.poor{background:#f9e6e6;color:#b54b4b}.team-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:18px 0}.team-kpis div{border:1px solid #e5ecf1;background:#f8fafb;border-radius:13px;padding:16px}.team-kpis strong{display:block;font-size:25px;color:#15283d}.team-kpis span{display:block;margin-top:4px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#8392a1}.overall-score-row{display:flex;justify-content:space-between;gap:20px;align-items:center;background:#f8fafb;border:1px solid #e5ecf1;border-radius:14px;padding:18px 20px}.overall-score-row>div:first-child{display:flex;align-items:baseline;gap:14px}.overall-score-row span{font-size:12px;color:#718398;font-weight:700}.overall-score-row strong{font-size:32px;color:#182f46}.overall-score-row em{font-size:17px;color:#5d8a57;font-style:normal;font-weight:800}.rank-block{text-align:right}.rank-block strong{display:block}.rank-block small{color:#8a98a6}.scorecard-section-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}.source-scorecard-section.wide{grid-column:1/-1}.source-section-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;border-bottom:1px solid #edf2f5}.source-section-head span{font-size:10px;letter-spacing:.1em;color:#8495a5;font-weight:800}.source-section-head h2{margin:4px 0 0;font-size:18px;color:#3f6350}.source-two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px}.source-two-col>div+div{border-left:1px solid #e9eef2;padding-left:18px}.source-two-col h3{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:#415469;margin:17px 0 8px}.source-metric-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px dashed #e8edf1}.source-metric-row>span{color:#647789;font-size:12px}.scorecard-source-value{text-align:right;display:flex;align-items:center;gap:6px}.scorecard-source-value b{font-size:12px;color:#17334d}.scorecard-source-value em{font-size:10px;font-style:normal;color:#6685bd}.muted-value{color:#a4aeb8}.focus-area-panel{margin-bottom:14px}.focus-chips{display:flex;flex-wrap:wrap;gap:8px}.focus-chips span{border:1px solid #dce8e3;background:#f2f9f6;color:#37695c;padding:9px 12px;border-radius:10px;font-size:12px;font-weight:650}.ops-leader-card{overflow:hidden}.leader-stack{display:flex;flex-direction:column}.leader-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto 58px;align-items:center;gap:10px;border:0;border-top:1px solid #edf2f5;background:#fff;padding:12px 4px;text-align:left;cursor:pointer;color:inherit}.leader-row:hover{background:#f8fbfa}.leader-name{min-width:0}.leader-name b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.leader-name small{display:block;color:#8b98a5;margin-top:2px}.tier-chip,.tier-inline,.target-status{display:inline-flex;align-items:center;justify-content:center;border-radius:999px;padding:5px 8px;font-size:10px;font-weight:800;white-space:nowrap}.tier-chip.good,.tier-inline.good,.target-status.good{background:#e5f6ef;color:#187761}.tier-chip.warn,.tier-inline.warn{background:#fff2dd;color:#9d6816}.tier-chip.bad,.tier-inline.bad,.target-status.bad{background:#fde7e9;color:#b8434e}.tier-chip.neutral,.tier-inline.neutral{background:#eef2f5;color:#6f7e8d}.pro-driver-score-table th,.pro-driver-score-table td{white-space:nowrap}.pro-driver-score-table .tier-inline{margin-left:6px}.ops-kpi-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:14px}.ops-kpi-strip>div{background:#10243a;color:#fff;border-radius:15px;padding:20px;border:1px solid #1c3852}.ops-kpi-strip span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:#8fa6bb}.ops-kpi-strip strong{display:block;font-size:28px;margin-top:8px}.ops-kpi-strip small{display:block;color:#6ad7c5;margin-top:6px}.cdf-category-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin-bottom:14px}.cdf-category-grid button{border:1px solid #dde6ec;background:#fff;border-radius:13px;padding:15px;text-align:left;display:flex;justify-content:space-between;gap:8px;cursor:pointer;color:#53677a}.cdf-category-grid button:hover,.cdf-category-grid button.active{border-color:#7eb7aa;background:#f1f9f6;color:#1f5e50}.cdf-category-grid span{font-size:11px;line-height:1.3}.cdf-category-grid strong{font-size:20px;color:#17334d}.cdf-table td{max-width:260px;white-space:normal}.ops-empty{min-height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center}.ops-empty span{max-width:520px;color:#7a8a99}.ops-empty.error b{color:#b5414b}.ops-empty-icon{width:46px;height:46px;border-radius:14px;background:#e9f6f2;display:grid;place-items:center;color:#20836e;font-size:22px}.ops-mini-empty{padding:34px 12px;text-align:center;color:#8c99a6}.ops-mini-empty.success{color:#327965}.driver-avatar.unresolved{background:#fff1dc;color:#9f6812}.inline-resolve{display:flex;gap:7px;min-width:430px}.inline-resolve input{min-width:220px;border:1px solid #dce5eb;border-radius:9px;padding:9px 10px}.btn.compact{padding:7px 10px;min-height:0}.data-quality-unmatched{margin-top:14px}.data-quality-unmatched select{min-width:280px}.site-select{padding-right:30px}.nav-section+button{}.app-nav button em.data-alert{background:#fbe5e7;color:#a93f49}.table-tools{gap:10px}.table-tools select{margin-left:auto}.leaderboard-grid{align-items:start}
@media(max-width:1100px){.scorecard-section-grid{grid-template-columns:1fr}.source-scorecard-section.wide{grid-column:auto}.team-kpis,.ops-kpi-strip{grid-template-columns:repeat(2,1fr)}}@media(max-width:720px){.scorecard-page-heading{align-items:flex-start}.scorecard-filter-row{width:100%}.scorecard-filter-row select{flex:1}.team-kpis,.ops-kpi-strip{grid-template-columns:1fr 1fr}.source-two-col{grid-template-columns:1fr}.source-two-col>div+div{border-left:0;padding-left:0;border-top:1px solid #e9eef2;padding-top:8px}.overall-score-row{align-items:flex-start;flex-direction:column}.rank-block{text-align:left}.inline-resolve{min-width:320px;flex-wrap:wrap}}@media(max-width:480px){.team-kpis,.ops-kpi-strip{grid-template-columns:1fr}}

